{
    "deno.enable": true,
    "deno.disablePaths": [
        "./.cargo/target",
        "./.output",
        "./.scratch",
    ],
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "./projects": true
    },
    "files.associations": {
        "*.ethos": "hcl"
    }
}