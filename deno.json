{
  "version": "0.0.0",
  "tasks": {
    "bootstrap": "sh scripts/bootstrap.sh",
    "migrate": "deno run -A scripts/migrate.tsx",
    "build": "deno run -A --unstable-ffi scripts/build.tsx",
    "dev": "deno run -A --unstable-ffi scripts/dev.tsx",
    "generate": "deno run -A templates/app/scripts/#generate.tsx",
    "run": "deno run -A --unstable-ffi scripts/run.tsx",
    "reset": "deno clean; deno cache -r . --allow-import --unstable-raw-imports"
  },
  "imports": {
    "@std/path": "jsr:@std/path",
    "@std/fs": "jsr:@std/fs",
    "@std/fs/glob": "jsr:@std/fs/glob",
