    "@std/http": "jsr:@std/http",
    "@std/assert": "jsr:@std/assert",
    "@std/cli": "jsr:@std/cli",
    "@std/toml": "jsr:@std/toml",
    "@types/node": "npm:@types/node",
    "@types/vscode": "npm:@types/vscode",
    "@types/react": "npm:@types/react@18.3.1",
