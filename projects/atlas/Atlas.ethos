/// A workspace means something 
/// f3
workspace Atlas {
    /// A way to monitor some other stuff, too!
    application Monitor {
        //..
    }
    
    /// The Core package is inferred, but if you want to
    /// override something during setup, you'd set that up
    /// here just like any other package.
    package Core {
        //..
    }
    
    /// Relay service ..
    package Relay {
        //..
    }
    
    /// Store service ..
    package Store {
        //..
    }
}