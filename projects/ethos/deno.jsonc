{
    "version": "0.0.0-preview",
    "license": "MIT",
    "tasks": {
        "install": "cargo install --path .",
        "build": "deno run -A scripts/build.tsx",
        "dev": "deno run -A scripts/dev.tsx"
    },
    "exclude": [
        "./.cargo",
        "./.vscode",
        "./.output",
        "./.scratch",
        "./spec"
    ],
    "exports": {
        ".": "./src/mod.ts",
        "./project": "./src/project.ts",
        "./workspace": "./src/workspace.ts"
    },
    "imports": {
        "@std/async": "jsr:@std/async@1.2.0",
        "@std/fs": "jsr:@std/fs@1.0.23",
        "@std/path": "jsr:@std/path@1.1.4",
        "@std/uuid/v5": "jsr:@std/uuid@1.1.0/v5",
        "@std/cli": "jsr:@std/cli@1.0.28",
        "@david/which": "jsr:@david/which@^0.4.1",
        "dzx": "https://deno.land/x/dzx@0.4.0/mod.ts",
        "dzx/runtime/process": "https://deno.land/x/dzx@0.4.0/src/runtime/process.ts"
    },
    "workspace": [
        "./services/dev",
        "./packages/core",
        "./dialects/ecma",
        "./dialects/toml",
        "./plugins/deno",
        "./plugins/flutter",
        "./plugins/nu"
    ]
}