{
    "name": "@brainbow/ethos",
    "version": "0.0.0",
    "tasks": {
        "install": "cargo install --path .",
        "build": "deno run -A scripts/build.tsx",
        "dev": "deno run -A scripts/dev.tsx"
    },
    "exports": {
        ".": "./src/mod.ts",
        "./project": "./src/project.ts",
        "./workspace": "./src/workspace.ts",
        "./dev": "./src/dev/mod.ts",
        "./dev/bundle": "./src/dev/bundle.ts",
        "./dev/fs": "./src/dev/fs.ts",
        "./dev/shell": "./src/dev/shell/mod.ts"
    },
    "imports": {
        "@std/cli": "jsr:@std/cli",
        "@david/which": "jsr:@david/which@^0.4.1",
        "dzx": "https://deno.land/x/dzx@0.4.0/mod.ts"
    }
}