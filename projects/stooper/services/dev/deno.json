{
  "name": "@stooper/dev",
  "tasks": {
    "init": "deno run ./scripts/init",
    "generate": "deno run ./scripts/.init.tsx"
  },
  "exclude": [
    "**/.git",
    "**/.output",
    "**/node_modules"
  ],
  "exports": {
    ".": "./src/mod.ts",
    "./generate": "./scripts/.init.tsx"
  },
  "imports": {
      "#assets/": "./assets/",
      "#src/": "./src/",
      "@std/path": "jsr:@std/path",
      "@std/uuid": "jsr:@std/uuid"
  },
  "compilerOptions": {
    "lib": [
      "esnext",
      "dom.asynciterable",
      "dom.iterable",
      "dom",
      "deno.unstable",
      "deno.worker",
      "deno.ns",
      "deno"
    ],
    "types": [
      "@types/node",
      "@types/vscode",
      "@types/react-dom",
      "@types/react"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}