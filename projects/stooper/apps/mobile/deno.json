{
  "name": "@stooper/mobile",
  "version": "0.0.0",
  "tasks": {
    "build": "deno run -A ./scripts/build.tsx",
    "dev": "deno run -A ./scripts/dev.tsx",
    "clean": "flutter clean && flutter pub get"
  },
  "exports": {
    ".": "./src/mod.ts"
  },
  "imports": {
    "@david/which": "jsr:@david/which@^0.4.1",
    "dzx": "https://deno.land/x/dzx@0.4.0/mod.ts"
  },
  "compilerOptions": {
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.unstable",
      "deno.worker",
      "deno.ns"
    ],
    "types": [
      "@types/node",
      "@types/vscode",
      "@types/react",
      "@types/react-dom"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}