{
    "deno.enable": false,
    "deno.enablePaths": [
        "./packages/ecma"
    ],
    "deno.disablePaths": [
        "**/.output"
    ],
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/flutter/ephemeral": true,
        "**/Flutter/ephemeral": true,
        "**/.symlinks": true,
        "**/.plugin_symlinks": true,
        "**/*.meta": true,
    }
}