{
    "name": "@brainbow/slate",
    "version": "0.0.0",
    "tasks": {
        "migrate": "deno run -A scripts/migrate.tsx",
        "dev": "deno run -A --unstable-ffi scripts/dev.tsx",
        "install": "deno run -A --unstable-ffi scripts/install.tsx"
    },
    "exports": {
        ".": "./src/mod.ts",
        "./terminal": "./src/terminal.ts",
        "./parse/markdown": "./src/parse/markdown.ts",
        "./jsx-runtime": "./src/jsx/runtime.ts",
        "./jsx": "./src/jsx/mod.ts"
    },
    "imports": {
        "react": "npm:react@18.3.1",
        "react/jsx-runtime": "npm:react@18.3.1/jsx-runtime",
        "react/jsx-dev-runtime": "npm:react@18.3.1/jsx-dev-runtime",
        "react-dom": "npm:react-dom@18.3.1",
        "react-dom/client": "npm:react-dom@18.3.1/client",
        "react-dom/server": "npm:react-dom@18.3.1/server",
        "react-router-dom": "npm:react-router-dom",
        "react-code-blocks": "npm:@react-code-blocks"
    },
    "compilerOptions": {
        "lib": [
            "esnext",
            "dom",
            "dom.iterable",
            "dom.asynciterable",
            "deno.unstable",
            "deno.worker",
            "deno.ns"
        ],
        "types": [
            "@types/node",
            "@types/vscode",
            "@types/react",
            "@types/react-dom",
            "react"
        ],
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "jsxImportSourceTypes": "@types/react"
    }
}