moodring.local {
    redir https://www.moodring.local{uri}
}

www.moodring.local {
    reverse_proxy localhost:8000
}

auth.moodring.local {
    reverse_proxy localhost:8220
}

vault.moodring.local {
    reverse_proxy localhost:8220
}

sketch.moodring.local {
    reverse_proxy localhost:3000
}

admin.moodring.local {
	reverse_proxy localhost:9000
}
