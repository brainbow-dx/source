{
    "name": "slate-vscode",
    "displayName": "Slate",
    "publisher": "brainbow-dx",
    "version": "0.0.0",
    "description": "Your package.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/brainbow-dx/slate.git"
    },
    "bugs": {
        "url": "https://github.com/brainbow-dx/slate/issues"
    },
    "engines": {
        "vscode": "^1.105.0"
    },
    "categories": [
        "Other"
    ],
    "scripts": {
        "vscode:prepublish": "echo 'TODO'",
        "compile": "tsc --jsx react-jsx -p ./",
        "watch": "tsc -watch --jsx react-jsx -p ./",
        "package": "npx --yes @vscode/vsce package",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "type": "module",
    "activationEvents": [],
    "contributes": {
        "commands": [
            {
                "command": "slate-vscode.helloWorld",
                "title": "Hello World"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "slate-vscode.helloWorld",
                    "when": "view == slate-sketch-pad",
                    "group": "navigation"
                },
                {
                    "command": "slate-vscode.helloWorld",
                    "when": "view == slate-sketch-pad",
                    "group": "navigation@1"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "slate-sketch-nav",
                    "title": "Sketch",
                    "icon": "assets/web/explorer/activity-icon.svg"
                }
            ],
            "panel": [
                {
                    "id": "slate-sketch-book",
                    "title": "Sketch",
                    "icon": "assets/web/explorer/activity-icon.svg"
                }
            ]
        },
        "views": {
            "slate-sketch-nav": [
                {
                    "id": "slate-sketch-inspector",
                    "name": "Sketch Inspector",
                    "type": "webview"
                }
            ],
            "slate-sketch-book": [
                {
                    "id": "slate-sketch-pad",
                    "name": "Sketch Pad",
                    "type": "webview"
                }
            ]
        },
        "customEditors": [
            {
                "viewType": "slate-sketch-editor",
                "displayName": "Sketch Editor",
                "priority": "default",
                "selector": [
                    {
                        "filenamePattern": "*.sketch.svg"
                    }
                ]
            },
            {
                "viewType": "slate-markup-editor",
                "displayName": "Markup Editor",
                "priority": "default",
                "selector": [
                    {
                        "filenamePattern": "*.html"
                    },
                    {
                        "filenamePattern": "*.uxml"
                    }
                ]
            },
            {
                "viewType": "slate-svg-editor",
                "displayName": "SVG Editor",
                "priority": "default",
                "selector": [
                    {
                        "filenamePattern": "*.svg"
                    }
                ]
            },
            {
                "viewType": "slate-markdown-editor",
                "displayName": "Markdown Editor",
                "priority": "default",
                "selector": [
                    {
                        "filenamePattern": "*.md"
                    },
                    {
                        "filenamePattern": "*.mdx"
                    },
                    {
                        "filenamePattern": "*.mdbook"
                    }
                ]
            }
        ]
    },
    "devDependencies": {
        "@types/vscode": "^1.105.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "22.x",
        "@typescript-eslint/eslint-plugin": "^8.45.0",
        "@typescript-eslint/parser": "^8.45.0",
        "eslint": "^9.36.0",
        "typescript": "^5.9.3",
        "@vscode/test-cli": "^0.0.11",
        "@vscode/test-electron": "^2.5.2"
    }
}