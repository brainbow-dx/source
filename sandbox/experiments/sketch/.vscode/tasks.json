{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev (watch)",
      "type": "shell",
      "command": "deno",
      "args": ["task", "dev", "--", "--generate", "--watch"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "build",
      "type": "shell",
      "command": "deno",
      "args": ["task", "build"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "install",
      "type": "shell",
      "command": "deno",
      "args": ["task", "install"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}

